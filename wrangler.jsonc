{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "atigabot",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-29",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  "rules": [
    {
      "type": "Data",
      "globs": ["**/*.ttf"],
      "fallthrough": true
    }
  ],
  "triggers": {
    "crons": ["0 23 * * *"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "atigabot-db",
      "database_id": "56e2609e-1584-4bc9-a8e9-013da2d6468b"
    }
  ],
  "r2_buckets": [
    {
      "binding": "ASSETS",
      "bucket_name": "atigabot-assets"
    }
  ]
}
